#!/usr/bin/env bash
# Utilizes git config for storing the manifest list and extension settings
# https://git-scm.com/docs/git-config
# with an emphasis on avoiding deprecated modes:
# https://git-scm.com/docs/git-config#_deprecated_modes
#
# TODO:
# - Use `gh repo search` along with `gh extension search` to cross reference installed extensions and uninstalled extensions
# - Expand settings UI to reflect most of what is expected from git config

declare -g manifest_file
declare -Ag settings=(
  ["commitOnSave"]="false"
  ["alwaysLatest"]="true"
  ["alwaysAppend"]="true"
  ["commitMessage"]="chore: update gh manifest"
)

if [[ ${BASH_VERSION:0:1} -lt 4 ]]; then
  printf "Bash is version %s; minimum required version is Bash 4." "$BASH_VERSION" >&2
  exit 1
fi

# https://www.gnu.org/software/bash/manual/html_node/Arrays.html
test_gh_list_output="\
gh foo	ninjack/foo	v0.2.1.3
gh bar	ninjack/bar	v0.6.9
gh baz	ninjack/baz	eeeeee"

# From `gh environment`:
#
# `GH_CONFIG_DIR`: the directory where gh will store configuration files. If not specified,
# the default value will be one of the following paths (in order of precedence):
#   - `$XDG_CONFIG_HOME/gh` (if `$XDG_CONFIG_HOME` is set),
#   - `$AppData/GitHub CLI` (on Windows if `$AppData` is set), or
#   - `$HOME/.config/gh`.
get_manifest_file() {
  [[ -n $GH_CONFIG_DIR ]] && echo -n "$GH_CONFIG_DIR/manifest"
  [[ -n $XDG_CONFIG_HOME ]] && echo -n "$XDG_CONFIG_HOME/gh/manifest"
  [[ -n $AppData ]] && echo -n "$AppData/Github\ CLI/gh/manifest"
  [[ -n $HOME ]] && echo -n "$HOME/.config/gh/manifest"
}

validate_manifest_file() {
  [[ -z "$manifest_file" ]] && {
    printf "Manifest file location could not be resolved" >&2
    exit 1
  }
}

show_help() {
  echo -n \
    "\
Save or restore a gh CLI extension manifest for reproduction on another machine.

Usage:
  gh [action] <flags ...>

Global flags:
--help, -h               Display this help message
--file=<file>, -f <file> Use a specific file for the manifest, as well as configuration options.

Actions:
save, update             Save the list of installed extensions to the manifest
--append, -a             Append currently installed extension list to the one found in the manifest
--commit, -c             Commit the changes to the manifest file to git

restore, install         Restore the list of installed extensions from the manifest
--latest, -l             Install the latest version of each extension (useful if alwaysLatest config option is false)
--exact, -e              Install the exact listed version of each extension (useful if alwaysLatest config option is true)

set [name value]...      Set config options in \"name\" \"value\" pairs.
unset                    Unset config options by passing one or more names.

The following are config options used by gh-manifest, stored in the same file as the manifest itself.
name          type   default                    description
commitOnSave  bool   false                      Whether or not to commit the changes to the manifest in whatever git repository it is being tracked by
commitMessage string \"chore: update            The commit message used if commitOnSave is enabled, or if --commit is used
                       gh extension manifest\"
alwaysLatest  bool   true                       Whether or not to always install the latest version of a plugin
alwaysAppend  bool   true                       Whether or not to append to the existing file, instead of overwriting
"
}

# Get a config value by key in the manifest file
get_config() {
  local key="$1"

  [[ -z $key ]] && return 1

  git config get --file "$manifest_file" "manifestSettings.$key" 2> /dev/null
}

# Set a config value by key in the manifest file
set_config() {
  local key="$1"
  local value="$2"

  [[ -z $key || -z $value ]] && exit 1 # TODO: Expand this error case
  [[ " ${!settings[*]} " == *" $key "* ]] || {
    printf "Unknown configuration key: %s" "$key" >&2
    exit 1
  }

  git config set --file "$manifest_file" manifestSettings."$key" "$value"
}

unset_config() {
  local key="$1"
  local value="$2"

  [[ -z $key || -z $value ]] && exit 1 # TODO: Expand this error case
  validate_key $key || {
    printf "Unknown configuration key: %s" "$key" >&2
    exit 1
  }

  git config unset --file "$manifest_file" manifestSettings."$key" "$value"
}

validate_key() {
  local key="$1"
  validate_key "$key" && return 0
  return 1
}

# Retrieves all config options from manifest file which have not been overridden by the user at runtime.
retrieve_all_configs() {
  for key in "${!settings[@]}"; do
    value=$(get_config "$key")
    [[ -n $value && -z "${settings[$key]}" ]] && settings[$key]=$value
  done
}

# Write the current gh extension list to manifest
write() {
  # Clear old manifest.* subsections
  if [[ ${settings["alwaysAppend"]} == "false" ]]; then
    readarray -t extensions < <(git config --file "$manifest_file" get --all --show-names --regexp '^manifest\.' \
      | cut -d. -f2 \
      | sort -u)

    for ext in "${extensions[@]}"; do
      git config --file "$manifest_file" --remove-section manifest."$ext" 2> /dev/null
    done
  fi

  # Read current extensions and write to config
  gh extension list | while IFS=$'\t' read -r name repo version; do
    git config --file "$manifest_file" manifest."$name".repo "$repo"
    git config --file "$manifest_file" manifest."$name".version "$version"
  done

  # Optional git commit if commit_manifest is true
  if [[ "${settings["commitOnSave"]}" == "true" ]]; then
    # Resolve symlinks (for scenarios where utilities like stow is being used)
    actual_file=$(
      file="$manifest_file"
      while file=$(readlink --canonicalize --no-newline "$file"); do :; done
      echo -n "$file"
    )
    if git -C "$(dirname "$actual_file")" ls-files --error-unmatch "$(basename "$actual_file")" > /dev/null 2>&1; then
      git -C "$(dirname "$actual_file")" add "$(basename "$actual_file")"
      git -C "$(dirname "$actual_file")" commit -m
    fi
  fi
}

# Restore extensions from manifest
# TODO:
# - The initial `git config get` retrieves configurations in the following format:
#   ```
#   manifest.gh act.repo nektos/gh-act
#   manifest.gh act.version v0.2.78
#   ```
#   As such, it's a bit redundant to call it twice more for the purpose of getting the repo and version. Worth looking into parsing it all from the initial string.
# - Wrap the result of the initial `git config get` into an array
# Overall, there's a lot of poor Bash here and it needs a rewrite.
restore() {
  git config get --file "$manifest_file" --all --show-names --regexp '^manifest\.' \
    | cut -d. -f2 \
    | sort -u \
    | while read -r extension; do
      echo "installing $extension"
      local repo version
      repo="$(git config get --file "$manifest_file" manifest."$extension".repo)"
      version="$(git config get --file "$manifest_file" manifest."$extension".version)"

      if [[ "${settings[alwaysLatest]}" == "true" ]]; then
        gh extension install "$repo"
      else
        gh extension install "$repo" --pin "$version"
      fi
    done
}

main() {

  [[ "$#" -eq 0 ]] && {
    show_help
    exit 1
  }

  declare MODE
  declare -A user_settings
  declare -a unset_settings
  # "Mutex" is not a great identifier here. It's just to determine if two mutually exclusive flags, e.g. --latest or --exact, are set.
  # TODO:
  # - Determine if:
  #   1) there's a nicer way (i.e. one without a secondary variable) to see if two mutually exclusive flags are set
  #   2) there's a clean way to use the conflicting flag in the error message
  declare VERSION_MUTEX

  manifest_file="$(get_manifest_file)"

  while [[ "$#" -gt 0 ]]; do
    [[ $1 == --*=* ]] && set -- "${1%%=*}" "${1#*=}" "${@:2}" # Expand --param=value arguments, thanks to this lovely comment: https://medium.com/@binaryphile/nice-one-elegant-in-its-simplicity-eee6b433bc90
    case $1 in
      ### GLOBAL FLAGS ###
      --file* | -f)
        manifest_file="$2"
        shift 2 2> /dev/null || {
          printf "No file passed" >&2
          exit 1
        }
        ;;
      -h | --help | help)
        show_help
        exit 0
        ;;
      ### ACTIONS ###
      save | update)
        [[ -z "$MODE" ]] || {
          printf "Multiple actions are not supported!" >&2
          exit 1
        }
        MODE="save"
        shift
        ;;
      --append | -a)
        [[ -z $MODE || $MODE == "save" ]] || {
          printf "Unknown flag for %s: %s\n" "$MODE" "$1" >&2
          exit 1
        }
        settings["alwaysAppend"]="true"
        ;;
      --commit | -c)
        [[ -z $MODE || $MODE == "save" ]] || {
          printf "Unknown flag for %s: %s\n" "$MODE" "$1" >&2
          exit 1
        }
        settings["commitOnSave"]="true"
        ;;
      --message | -m)
        [[ -z $MODE || $MODE == "save" ]] || {
          printf "Unknown flag for %s: %s\n" "$MODE" "$1" >&2
          exit 1
        }
        settings["commitMessage"]=$2
        shift 2 2> /dev/null || {
          printf "No message passed to %s\n" "$1" >&2
          exit 1
        }
        ;;
      restore | install)
        [[ -z "$MODE" ]] || {
          printf "Multiple actions are not supported!" >&2
          exit 1
        }
        MODE="restore"
        shift
        ;;
      --latest | -l)
        [[ -z "$MODE" || $MODE == "restore" ]] || {
          printf "Unknown flag for %s: %s\n" "$MODE" "$1" >&2
          exit 1
        }
        [[ -z $VERSION_MUTEX ]] || {
          printf "Conflicting flags: --exact (or -e) and %s\n" "$1" >&2
          exit 1
        }
        settings["alwaysLatest"]="true"
        shift
        ;;
      --exact | -e)
        [[ -z "$MODE" || $MODE == "restore" ]] || {
          printf "Unknown flag for %s: %s\n" "$MODE" "$1" >&2
          exit 1
        }
        [[ -z $VERSION_MUTEX ]] || {
          printf "Conflicting flags: --latest (or -l) and %s\n" "$1" >&2
          exit 1
        }
        settings["alwaysLatest"]="false"
        shift
        ;;
      set)
        [[ -z "$MODE" ]] || {
          printf "Multiple actions are not supported!"
          exit 1
        }
        MODE="set"
        shift
        # TODO:
        # - Validate config types as well, perhaps. See https://git-scm.com/docs/git-config#Documentation/git-config.txt---typetype
        ;;
      unset)
        MODE="unset"
        shift
        ;;
      *)
        # TODO: Break this out into its own function, perhaps
        if [[ $MODE == "set" || $MODE == "unset" ]]; then
          validate_key "$1" || {
            printf "Key %s is not a supported option\n" "$1" >&2
            exit 1
          }
          case "$MODE" in
            "set")
              [[ -z "$2" ]] || {
                printf "No value provided to key %s\n" "$1"
                exit 1
              }
              user_settings[$1]=$2
              shift 2
              ;;
            "unset")
              unset_settings+=("$1")
              shift
              ;;
          esac
        else
          # TODO:
          # - Expand this to allow for more advanced errors, e.g. if it's a flag, tie it to the given command.
          printf "Unknown parameter: %s\n" "$1" >&2
          exit 1
        fi
        ;;
    esac
  done

  validate_manifest_file
  retrieve_all_configs

  case "$MODE" in
    "save")
      write
      ;;
    "restore")
      restore
      ;;
    "set")
      [[ -z "${user_settings[*]}" ]] && { printf "No setting keys passed to unset!\n"; exit 1; }
      for key in "${!user_settings[@]}"; do
        set_config "$key" "${user_settings[$key]}"
      done
      ;;
    "unset")
      [[ -z "${unset_settings[*]}" ]] && { printf "No setting keys passed to unset!\n"; exit 1; }
      for key in "${unset_settings[@]}"; do
        unset_config "$key"
      done
      ;;
    *)
      printf "Unknown mode: %s. Please open an issue if you are seeing this." "$MODE" >&2
      exit 1
      ;;
  esac
}

main "$@"
